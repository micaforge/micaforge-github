#!/usr/bin/env python3
"""gh-avatar-prep — make any image GitHub-avatar-ready.

GitHub avatars: square, under 1 MB (PNG/GIF/JPG). This takes any input
image, center-crops to square, resizes to 460px, and saves an optimized
PNG under the limit. Upload itself is still a manual browser step
(GitHub has no avatar-upload API) — see references/profile-settings.md.

Usage: gh-avatar-prep <input> [-o output.png] [--size 460]
"""
import os
import sys

try:
    from PIL import Image
except ImportError:
    print("gh-avatar-prep: needs Pillow (pip install pillow)", file=sys.stderr)
    sys.exit(1)

MAX_BYTES = 1_000_000


def main() -> None:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return
    src = args[0]
    size = 460
    out = None
    if "--size" in args:
        size = int(args[args.index("--size") + 1])
    if "-o" in args:
        out = args[args.index("-o") + 1]
    if out is None:
        base, _ = os.path.splitext(src)
        out = f"{base}-github.png"

    img = Image.open(src).convert("RGB")
    # center-crop to square
    w, h = img.size
    side = min(w, h)
    img = img.crop(((w - side) // 2, (h - side) // 2,
                    (w + side) // 2, (h + side) // 2))
    img = img.resize((size, size), Image.LANCZOS)
    img.save(out, optimize=True)
    n = os.path.getsize(out)
    if n > MAX_BYTES:
        # shrink until under the limit
        while n > MAX_BYTES and size > 100:
            size = int(size * 0.9)
            img = img.resize((size, size), Image.LANCZOS)
            img.save(out, optimize=True)
            n = os.path.getsize(out)
    print(f"{out} ({n} bytes)")
    if n > MAX_BYTES:
        print("gh-avatar-prep: still over 1 MB — try a simpler image",
              file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
